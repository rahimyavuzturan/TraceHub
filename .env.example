# TraceHub ayar sablonu.
# Kopyala: cp .env.example .env  — GERCEK SIRLARI ASLA COMMIT ETME.

# --- Uygulama ---
TRACEHUB_ENV=dev
TRACEHUB_LOG_LEVEL=INFO
TRACEHUB_LOG_JSON=false

# --- Veritabani ---
TRACEHUB_DATABASE_URL=postgresql+asyncpg://tracehub:tracehub_dev_only@localhost:5433/tracehub

# --- LLM (vLLM / OpenAI uyumlu) ---
# provider: mock | openai_compatible
TRACEHUB_LLM__PROVIDER=mock
TRACEHUB_LLM__BASE_URL=http://vllm.internal:8000/v1
TRACEHUB_LLM__MODEL=Qwen/Qwen3-32B-Instruct
TRACEHUB_LLM__API_KEY=
TRACEHUB_LLM__TIMEOUT_SECONDS=120
TRACEHUB_LLM__MAX_TOKENS=4096
TRACEHUB_LLM__TEMPERATURE=0.1

# --- Embedding ---
# provider: hash | openai_compatible   (hash = yerel deterministik, sadece gelistirme icin)
TRACEHUB_EMBEDDING__PROVIDER=hash
TRACEHUB_EMBEDDING__BASE_URL=http://tei.internal:8080/v1
TRACEHUB_EMBEDDING__MODEL=BAAI/bge-m3
TRACEHUB_EMBEDDING__API_KEY=
TRACEHUB_EMBEDDING__DIMENSIONS=1024

# --- Bilgi tabani ---
TRACEHUB_KB__ROOT=knowledge
TRACEHUB_KB__CHUNK_TOKENS=700
TRACEHUB_KB__CHUNK_OVERLAP_TOKENS=100

# --- Arastirma butceleri ---
TRACEHUB_BUDGET__MAX_STEPS=25
TRACEHUB_BUDGET__MAX_SECONDS=600
TRACEHUB_BUDGET__MAX_TOOL_OUTPUT_CHARS=20000

# --- API ---
TRACEHUB_API__HOST=0.0.0.0
TRACEHUB_API__PORT=8000
TRACEHUB_API__CORS_ORIGINS=["http://localhost:5173"]
# openssl rand -hex 32 ile uret
TRACEHUB_API__JWT_SECRET=change-me-in-production-please-use-a-random-32-byte-hex
TRACEHUB_API__JWT_TTL_MINUTES=720
